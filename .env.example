# Browser-facing frontend configuration used by Docker Compose.
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000

AUCTION_MIN_DURATION_SECONDS=30
AUCTION_MAX_DURATION_SECONDS=604800
AUCTION_SCANNER_INTERVAL_SECONDS=30
