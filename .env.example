NODE_ENV=development
PORT=3000

DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=auction
DATABASE_PASSWORD=auction
DATABASE_NAME=auction

REDIS_HOST=redis
REDIS_PORT=6379

JWT_SECRET=replace-me-in-local-env
JWT_EXPIRES_IN=1d
